{
  "name": "wellstudio-platform",
  "version": "0.1.0",
  "private": true,
  "description": "WellStudio modular monolith built with Next.js.",
  "packageManager": "pnpm@10.21.0",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:deploy": "prisma migrate deploy",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "check:foundation": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm build",
    "check:auth": "pnpm lint && pnpm typecheck && vitest run tests/unit/auth && pnpm build",
    "check:reservations": "pnpm lint && pnpm typecheck && vitest run tests/unit/reservations && pnpm build",
    "check:payments": "pnpm lint && pnpm typecheck && vitest run tests/unit/payments && pnpm build",
    "agentation:doctor": "agentation-mcp doctor",
    "agentation:mcp": "agentation-mcp server",
    "agentation:mcp:memory": "AGENTATION_STORE=memory agentation-mcp server",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:auth": "playwright test tests/e2e/auth",
    "test:e2e:auth:sandbox": "playwright test tests/e2e/auth/auth-sandbox.spec.ts",
    "test:e2e:reservations:sandbox": "playwright test tests/e2e/reservations/reservations-sandbox.spec.ts",
    "test:e2e:admin:leads": "playwright test tests/e2e/admin/admin-leads.spec.ts",
    "test:e2e:admin:notifications": "playwright test tests/e2e/admin/admin-notifications.spec.ts",
    "test:e2e:session-notifications": "playwright test tests/e2e/admin/admin-session-notifications.spec.ts tests/e2e/notifications/session-change-email.spec.ts",
    "test:e2e:payments:sandbox": "playwright test tests/e2e/payments/credit-pack-checkout.spec.ts",
    "test:e2e:admin:sessions": "playwright test tests/e2e/admin/admin-sessions.spec.ts",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "sandbox:auth:member": "node scripts/auth/ensure-sandbox-user.mjs member --confirm-sandbox-reset",
    "sandbox:auth:admin": "node scripts/auth/ensure-sandbox-user.mjs admin --confirm-sandbox-reset",
    "sandbox:scenario": "node scripts/sandbox/ensure-member-scenario.mjs --confirm-sandbox-scenario",
    "sandbox:admin-playground": "node scripts/sandbox/ensure-member-scenario.mjs admin-playground --confirm-sandbox-scenario",
    "codex:doctor": "node scripts/codex/check-cloud-env.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.99.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next": "^16.1.6",
    "pg": "^8.20.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "shadcn": "^4.0.6",
    "stripe": "^22.4.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "agentation": "^2.3.3",
    "agentation-mcp": "^1.2.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.1.6",
    "prisma": "^7.5.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
